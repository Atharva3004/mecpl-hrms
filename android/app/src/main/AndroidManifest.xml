<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for Flutter text processing -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Android 11+ requires explicit <queries> so open_file can resolve a
             PDF viewer when the Payslip "OPEN" action fires. Without this,
             OpenFile.open(...) returns "no APP found to open this file". -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>
        <!-- Same rationale for the system share sheet (share_plus). -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="application/pdf" />
        </intent>
        <!-- url_launcher: needed so external https links in the Useful Links
             screen (EPFO/ESI/UMANG) resolve to a browser on Android 11+. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>

    <!-- Workmanager periodic task for 30-min location pings. Survives app kill. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- Android 14 split foreground-service permission — required when the
         periodic task needs location while executing. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>

    <!-- Biometric (fingerprint / face) for app-launch unlock via local_auth. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.USE_FINGERPRINT"/>

    <!-- Required on Android 13+ for FCM panel notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.front" android:required="false"/>

    <application
        android:name="${applicationName}"
        android:label="MECPL HRMS"
        android:icon="@mipmap/launcher_icon"
        android:usesCleartextTraffic="true"
        android:theme="@style/LaunchTheme">

        <meta-data
        android:name="com.google.android.geo.API_KEY"
        android:value="AIzaSyBH7vA0GafCH3xdpQ-71erNxM_ACt0ZtZ0"/>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Flutter embedding -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- FCM: channel + icon used when a notification arrives while app is
             killed/backgrounded. Channel id must match the one created in
             NotificationService. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="mecpl_default" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/launcher_icon" />

        <!-- Attendance location tracking (flutter_foreground_task).
             Runs the 30-minute ping loop in its own isolate between punch-in
             and punch-out. Declared here because the plugin's own manifest
             only ships the boot/restart receivers, not the service.

             foregroundServiceType="location" is required from Android 14
             (API 34) for a service that reads location, and must match the
             FOREGROUND_SERVICE_LOCATION permission declared above.

             This service is what keeps pings running after the user swipes
             the app out of recents — the previous Geolocator position stream
             was listened to on the main isolate and died with the activity. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="location"
            android:exported="false" />

    </application>

</manifest>
