<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>NSCameraUsageDescription</key>
		<string>This app needs camera access to capture candidate photos during pre-recruitment.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>This app needs photo library access to attach candidate photos.</string>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Mecpl Flutter</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>mecpl_flutter</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<true/>
		<key>UIViewControllerBasedStatusBarAppearance</key>
		<false/>

		<!-- Face ID prompt shown when the user unlocks the app on launch.
		     Required whenever the app calls `local_auth` on iOS devices
		     that have Face ID hardware. -->
		<key>NSFaceIDUsageDescription</key>
		<string>Use Face ID to unlock MECPL HRMS.</string>

		<!-- Location permission prompts shown to the user. "Always" is needed
		     so the 30-min background pings keep firing after the user
		     switches away from the app or the phone is locked. -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>MECPL HRMS uses your location to record punch-in / punch-out and to log your location while you're on duty.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>MECPL HRMS sends a location ping every 30 minutes while you're on duty so your manager can verify attendance. Tracking starts on punch-in and stops on punch-out.</string>
		<key>NSLocationAlwaysUsageDescription</key>
		<string>MECPL HRMS sends a location ping every 30 minutes while you're on duty so your manager can verify attendance. Tracking starts on punch-in and stops on punch-out.</string>

		<!-- Background execution. `fetch` lets BGTaskScheduler wake us up
		     periodically; `location` lets us take a GPS fix in the
		     background when woken. -->
		<key>UIBackgroundModes</key>
		<array>
			<string>fetch</string>
			<string>location</string>
			<string>processing</string>
		</array>

		<!-- Task identifiers Workmanager is allowed to schedule via
		     BGTaskScheduler. Must match `kBackgroundPingTaskName` in Dart. -->
		<key>BGTaskSchedulerPermittedIdentifiers</key>
		<array>
			<string>mecpl.attendance.location_ping</string>
			<string>be.tramckrijte.workmanager.iOSBackgroundAppRefresh</string>
			<string>be.tramckrijte.workmanager.iOSBackgroundProcessingTask</string>
		</array>
	</dict>
</plist>
